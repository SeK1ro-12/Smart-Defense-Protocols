																																public override void Activate()
																																{
																																Dialog_DefenseSettings window = Find.WindowStack.WindowOfType<Dialog_DefenseSettings>();
        if (window != null)
        {
            Find.WindowStack.TryRemove(window);
        }
        else
        {
            Find.WindowStack.Add(new Dialog_DefenseSettings());
        }
    }

    public override void DoButton(Rect rect)
    {
        base.DoButton(rect);

        Color statusColor;
        switch (DefenseManager.CurrentAlert)
        {
            case AlertLevel.Green: statusColor = new Color(0.2f, 0.85f, 0.3f, 0.9f); break;
            case AlertLevel.Yellow: statusColor = new Color(1f, 0.85f, 0.2f, 0.9f); break;
            case AlertLevel.Red: statusColor = new Color(1f, 0.25f, 0.25f, 0.9f); break;
            default: statusColor = Color.white; break;
        }

        Rect indicatorRect = new Rect(rect.x + 3f, rect.yMax - 3f, rect.width - 6f, 2f);
        UIHelper.DrawSolidColor(indicatorRect, statusColor);

        TooltipHandler.TipRegion(rect, "SmartDefense.Tip.Protocol".Translate(GetAlertStatusText(DefenseManager.CurrentAlert)));
    }

    private string GetAlertStatusText(AlertLevel level)
    {
        switch (level)
        {
            case AlertLevel.Green: return "SmartDefense.Alert.Green".Translate();
            case AlertLevel.Yellow: return "SmartDefense.Alert.Yellow.Full".Translate();
            case AlertLevel.Red: return "SmartDefense.Alert.Red.Full".Translate();
            default: return "SmartDefense.Alert.Green".Translate();
        }
    }
}

public class Dialog_DefenseSettings : Window
{
    private int currentTab = 0;
    private Vector2 scrollPosition = Vector2.zero;

    public override Vector2 InitialSize => new Vector2(920f, 680f);

    public Dialog_DefenseSettings()
    {
        this.forcePause = false;
        this.preventCameraMotion = false;
        this.absorbInputAroundWindow = false;
        this.closeOnClickedOutside = false;
        this.doCloseX = true;
        this.doCloseButton = true;
        this.draggable = true;
    }

    public override void DoWindowContents(Rect inRect)
    {
        Listing_Standard listing = new Listing_Standard();
        listing.Begin(inRect);

        // Title Header Badge
        Text.Font = GameFont.Medium;
        string titleText = GetDEFCONHeader();
        listing.Label(titleText);
        Text.Font = GameFont.Small;
        listing.Gap(10f);

        // Tabs
        Rect tabRect = listing.GetRect(30f);
        float tabWidth = tabRect.width / 4f;

        if (UIHelper.DrawStyledButton(new Rect(tabRect.x, tabRect.y, tabWidth - 2f, 28f), "SmartDefense.Tab.Main".Translate(), currentTab == 0 ? new Color(0.2f, 0.4f, 0.6f) : new Color(0.15f, 0.15f, 0.15f), Color.gray, Color.white)) currentTab = 0;
        if (UIHelper.DrawStyledButton(new Rect(tabRect.x + tabWidth, tabRect.y, tabWidth - 2f, 28f), "SmartDefense.Tab.Pawns".Translate(), currentTab == 1 ? new Color(0.2f, 0.4f, 0.6f) : new Color(0.15f, 0.15f, 0.15f), Color.gray, Color.white)) currentTab = 1;
        if (UIHelper.DrawStyledButton(new Rect(tabRect.x + tabWidth * 2f, tabRect.y, tabWidth - 2f, 28f), "SmartDefense.Tab.Animals".Translate(), currentTab == 2 ? new Color(0.2f, 0.4f, 0.6f) : new Color(0.15f, 0.15f, 0.15f), Color.gray, Color.white)) currentTab = 2;
        if (UIHelper.DrawStyledButton(new Rect(tabRect.x + tabWidth * 3f, tabRect.y, tabWidth - 2f, 28f), "SmartDefense.Tab.Mechs".Translate(), currentTab == 3 ? new Color(0.2f, 0.4f, 0.6f) : new Color(0.15f, 0.15f, 0.15f), Color.gray, Color.white)) currentTab = 3;

        listing.Gap(10f);

        // Tab content rendering
        Rect contentRect = listing.GetRect(inRect.height - 130f);
        switch (currentTab)
        {
            case 0: DrawMainTab(contentRect); break;
            case 1: DrawPawnsTab(contentRect); break;
            case 2: DrawAnimalsTab(contentRect); break;
            case 3: DrawMechsTab(contentRect); break;
        }

        listing.End();
    }

    private string GetDEFCONHeader()
    {
        switch (DefenseManager.CurrentAlert)
        {
            case AlertLevel.Green: return "SmartDefense.DEFCON.Green".Translate();
            case AlertLevel.Yellow: return "SmartDefense.DEFCON.Yellow".Translate();
            case AlertLevel.Red: return "SmartDefense.DEFCON.Red".Translate();
            default: return "SmartDefense.DEFCON.Unknown".Translate();
        }
    }

    private void DrawMainTab(Rect rect)
    {
        Listing_Standard listing = new Listing_Standard();
        listing.Begin(rect);

        listing.Label("SmartDefense.Header.QuickDEFCON".Translate());
        Rect btnRect = listing.GetRect(32f);
        float bw = btnRect.width / 3f;

        if (UIHelper.DrawStyledButton(new Rect(btnRect.x, btnRect.y, bw - 4f, 32f), "SmartDefense.Btn.GreenCode".Translate(), new Color(0.1f, 0.5f, 0.2f), new Color(0.2f, 0.7f, 0.3f), Color.green))
            DefenseManager.SetAlertLevel(AlertLevel.Green);

        if (UIHelper.DrawStyledButton(new Rect(btnRect.x + bw, btnRect.y, bw - 4f, 32f), "SmartDefense.Btn.YellowCode".Translate(), new Color(0.6f, 0.5f, 0.1f), new Color(0.8f, 0.7f, 0.2f), Color.yellow))
            DefenseManager.SetAlertLevel(AlertLevel.Yellow);

        if (UIHelper.DrawStyledButton(new Rect(btnRect.x + bw * 2f, btnRect.y, bw - 4f, 32f), "SmartDefense.Btn.RedCode".Translate(), new Color(0.6f, 0.1f, 0.1f), new Color(0.8f, 0.2f, 0.2f), Color.red))
            DefenseManager.SetAlertLevel(AlertLevel.Red);

        listing.Gap(15f);
        listing.Label("SmartDefense.Header.AdditionalOptions".Translate());

        listing.CheckboxLabeled("SmartDefense.Opt.ManualModeOnly".Translate(), ref DefenseSettings.ManualModeOnly);
        listing.CheckboxLabeled("SmartDefense.Opt.AutoDraftCombatants".Translate(), ref DefenseSettings.AutoDraftCombatants);
        listing.CheckboxLabeled("SmartDefense.Opt.AutoToggleTurrets".Translate(), ref DefenseSettings.AutoToggleTurrets);
        listing.CheckboxLabeled("SmartDefense.Opt.InstantTurretToggle".Translate(), ref DefenseSettings.InstantTurretToggle);
        listing.CheckboxLabeled("SmartDefense.Opt.AutoRedOnRaid".Translate(), ref DefenseSettings.AutoRedOnRaid);
        listing.CheckboxLabeled("SmartDefense.Opt.AutoYellowOnRaidEnd".Translate(), ref DefenseSettings.AutoYellowOnRaidEnd);

        listing.End();
    }

    private void DrawPawnsTab(Rect rect)
    {
        Widgets.Label(rect, "SmartDefense.Tab.Pawns".Translate());
    }

    private void DrawAnimalsTab(Rect rect)
    {
        Widgets.Label(rect, "SmartDefense.Tab.Animals".Translate());
    }

    private void DrawMechsTab(Rect rect)
    {
        Widgets.Label(rect, "SmartDefense.Tab.Mechs".Translate());
    }
}


